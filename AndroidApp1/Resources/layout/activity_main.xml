<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp">

	<TextView
        android:id="@+id/yaziAlani"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Favori Arabalar"
        android:textSize="22sp" />

	<Button
        android:id="@+id/tiklaButon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Güncelle" />

	<EditText
        android:id="@+id/iddeger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Araba ID"
        android:inputType="number" />

	<EditText
        android:id="@+id/stringdeger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Araba Modeli" />

	<Button
        android:id="@+id/tiklaButon2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Değiştir" />

</LinearLayout>